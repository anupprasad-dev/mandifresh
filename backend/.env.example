# Copy to .env for local development. NEVER commit the real .env file.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use local SQLite. For Neon paste the connection string:
# postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Frontend origin(s), comma separated (used for CORS / CSRF / reset links)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Admin panel path (change in production to something non-obvious)
ADMIN_URL=admin/

# Email (password reset). Console backend prints emails in the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MandiFresh <no-reply@mandifresh.local>


